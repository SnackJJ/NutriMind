# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# NutriMind v2.0 data factory — teacher + expander share one provider and one
# credential (ADR-011 amended 2026-09-09: ark/deepseek-v4-flash on api/plan/v3).
# The factory clients POST {ARK_BASE_URL}/chat/completions; the path is also
# pinned in configs/data_factory.yaml (teacher.endpoint / expander.endpoint).
# Real network calls require NUTRIMIND_ALLOW_NETWORK=1 (spec §16); tests always
# inject fakes.
ARK_API_KEY=your_ark_api_key_here
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3

# Optional: Hugging Face for model downloads
HF_TOKEN=your_hf_token_here
# Optional: HF mirror for faster downloads (e.g. in China)
# HF_ENDPOINT=https://hf-mirror.com
