# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# NutriMind v2.0 data factory. Production teacher + expander use the DeepSeek
# official API (DEEPSEEK_API_KEY, model deepseek-flash). Command Code is an
# optional channel (--teacher commandcode / --expander commandcode).
# Real network calls require NUTRIMIND_ALLOW_NETWORK=1; tests inject fakes.
COMMANDCODE_API_KEY=your_commandcode_api_key_here
COMMANDCODE_BASE_URL=https://api.commandcode.ai/provider/v1

# Optional: Hugging Face for model downloads
HF_TOKEN=your_hf_token_here
# Optional: HF mirror for faster downloads (e.g. in China)
# HF_ENDPOINT=https://hf-mirror.com
