# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# NutriMind v2.0 data factory — teacher + expander share one provider and one
# credential (ADR-011 amended 2026-09-13: Command Code Provider API,
# deepseek/deepseek-v4.1-flash). Real network calls require
# NUTRIMIND_ALLOW_NETWORK=1 (spec §16); tests always inject fakes.
COMMANDCODE_API_KEY=your_commandcode_api_key_here
COMMANDCODE_BASE_URL=https://api.commandcode.ai/provider/v1

# Previous pin (ADR-011 2026-09-09 ark/deepseek-v4-flash). Unused by the
# current configs/data_factory.yaml; keep placeholders so old runbooks resolve.
ARK_API_KEY=your_ark_api_key_here
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3

# Optional: Hugging Face for model downloads
HF_TOKEN=your_hf_token_here
# Optional: HF mirror for faster downloads (e.g. in China)
# HF_ENDPOINT=https://hf-mirror.com
